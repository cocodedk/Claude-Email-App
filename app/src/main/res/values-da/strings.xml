    <string name="onboarding_p1_eyebrow">01 · KOMMANDO</string>
    <string name="onboarding_p1_title">Send Claude en mail. Den udfører opgaven.</string>
    <string name="onboarding_p1_body">Send en kommando til din claude-email-tjeneste. Tjenesten udfører arbejdet i det projekt, du angiver, og svarer, når det er færdigt.</string>

    <string name="onboarding_p2_eyebrow">02 · SAMTALER</string>
    <string name="onboarding_p2_title">Tråde, ikke en indbakke.</string>
    <string name="onboarding_p2_body">Hver opgave er en samtale. Skift mellem dem med fanerne Aktive, Venter og Arkiverede. Stryg en samtale mod venstre for at arkivere den.</string>

    <string name="onboarding_p3_eyebrow">03 · KRYPTERET</string>
    <string name="onboarding_p3_title">Loginoplysninger gemt krypteret.</string>
    <string name="onboarding_p3_body">Dine loginoplysninger gemmes krypteret med en nøgle i Android Keystore. Appen logger ind på dine egne mailservere og tjekker dem for svar. Hvis du angiver en delt hemmelighed, sendes den med dine kommandoer. Android kan tage backup af appens data.</string>

